# Hostinger FTP credentials template.
# Copy to .env and fill in real values (.env is gitignored — never commit it).
# Deploys run via GitHub Actions using repo secrets with these same names:
# gh secret set FTP_SERVER / FTP_USERNAME / FTP_PASSWORD (deekshipress.com)
# gh secret set FTP_IN_SERVER / FTP_IN_USERNAME / FTP_IN_PASSWORD (deekshipress.in)

FTP_SERVER=ftp.example.com
FTP_USERNAME=your-ftp-username
FTP_PASSWORD=your-ftp-password

FTP_IN_SERVER=ftp.example.in
FTP_IN_USERNAME=your-ftp-username-in
FTP_IN_PASSWORD=your-ftp-password-in
